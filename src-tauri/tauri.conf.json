{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anchor",
  "version": "0.1.23",
  "identifier": "com.anchor.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Anchor",
        "width": 1180,
        "height": 780,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "mobile": [
        {
          "scheme": ["anchor"],
          "host": "dropbox",
          "pathPrefix": ["/callback"]
        }
      ],
      "desktop": {
        "schemes": ["anchor"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBCN0JDQTMyQzlFMjc3Q0EKUldUS2QrTEpNc3A3Q3dSODhGeDZXVFZybStrVm0wQnREWUd0V1g2dHgzcXhEOVFUdGcrSm8yWUQK",
      "endpoints": [
        "https://github.com/racstan/Anchor/releases/latest/download/latest.json"
      ]
    }
  }
}
