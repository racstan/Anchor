{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "android-installer:default",
    "core:default",
    "deep-link:default",
    "fs:default",
    {
      "identifier": "fs:allow-write-file",
      "allow": [{ "path": "$APPCACHE/*" }]
    },
    "notification:default",
    "upload:default",
    "opener:default"
  ]
}
